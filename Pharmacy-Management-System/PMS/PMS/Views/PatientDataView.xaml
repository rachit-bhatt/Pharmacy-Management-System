<UserControl x:Class="PMS.Views.PatientDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PMS.Views"
             xmlns:viewModels="clr-namespace:PMS.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:PMS.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:validation="clr-namespace:PMS.Views.Validations"
             xmlns:controls="clr-namespace:PMS.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:PatientDataViewModel}"
             d:DesignWidth="400"
             d:DesignHeight="300"
             d:Foreground="White">

    <UserControl.Resources>
        <!-- Common style for labels -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Common style for textboxes -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsEnabled" Value="{Binding IsEditing}" />
        </Style>
        <!-- Common style for DatePicker -->
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsEnabled" Value="{Binding IsEditing}" />
        </Style>
        <!-- Style for icon buttons -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="materialDesign:PackIcon">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignIconForeground}" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <!-- ... (header and resources unchanged) ... -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with icons (unchanged) ... -->

        <Grid Grid.Row="1" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="First Name:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" />
            <controls:ValidatedField Grid.Row="0" Grid.Column="1"
                                 BoundPropertyName="FirstName"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Last Name:" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="1" Grid.Column="1"
                                 BoundPropertyName="LastName"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Email:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="2" Grid.Column="1"
                                 BoundPropertyName="Email"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Contact:" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="3" Grid.Column="1"
                                 BoundPropertyName="Contact"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Date of Birth:" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="4" Grid.Column="1"
                                 BoundPropertyName="DateOfBirth"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <DatePicker SelectedDate="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                            DisplayDateEnd="{x:Static sys:DateTime.Today}"
                            Style="{StaticResource DatePickerStyle}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Age:" Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <TextBlock Text="{Binding Patient.Age}" Grid.Row="5" Grid.Column="1" Style="{StaticResource LabelStyle}"/>

            <TextBlock Text="Gender:" Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="6" Grid.Column="1"
                                 BoundPropertyName="Gender"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Address:" Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="7" Grid.Column="1"
                                 BoundPropertyName="Address"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Medical History:" Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="8" Grid.Column="1"
                                 BoundPropertyName="MedicalHistory"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding MedicalHistory, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Emergency Contact:" Grid.Row="9" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="9" Grid.Column="1"
                                 BoundPropertyName="EmergencyContact"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding EmergencyContact, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Blood Group:" Grid.Row="10" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="10" Grid.Column="1"
                                 BoundPropertyName="BloodGroup"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding BloodGroup, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Allergies:" Grid.Row="11" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="11" Grid.Column="1"
                                 BoundPropertyName="Allergies"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding Allergies, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <TextBlock Text="Notes:" Grid.Row="12" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
            <controls:ValidatedField Grid.Row="12" Grid.Column="1"
                                 BoundPropertyName="Notes"
                                 ErrorPosition="Right"
                                 DataContext="{Binding Patient}">
                <controls:ValidatedField.FieldContent>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}" />
                </controls:ValidatedField.FieldContent>
            </controls:ValidatedField>

            <Button Grid.Row="13" Grid.ColumnSpan="2"
                Content="_Save"
                HorizontalAlignment="Right"
                Width="100"
                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</UserControl>